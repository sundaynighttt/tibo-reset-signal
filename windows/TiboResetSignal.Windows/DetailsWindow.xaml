<Window x:Class="TiboResetSignal.WinApp.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tibo Reset Signal"
        Width="370"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Margin="8" Padding="18" CornerRadius="16"
            Background="#FA1C1C1F" BorderBrush="#38FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tibo Reset Signal" Foreground="#F5F5F6"
                               FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="공개 신호 확인 중"
                               Margin="0,2,0,0" Foreground="#9FA0A8" FontSize="11.5" />
                </StackPanel>
                <Button Grid.Column="1" Width="28" Height="28" Content="×"
                        Foreground="#C8C8CD" Background="Transparent" BorderThickness="0"
                        FontSize="18" Cursor="Hand" Click="CloseButton_OnClick" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,15,0,12">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="MainDot" Width="26" Height="26" Margin="0,4,10,0" Fill="#73737A" />
                    <TextBlock x:Name="MainStatusText" Text="확인 지연"
                               Foreground="#FFFFFF" FontSize="30" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="ScoreText" Text="–" Margin="38,-2,0,0"
                           Foreground="#B9BAC1" FontSize="12" />
            </StackPanel>
            <Border Grid.Row="2" Margin="0,0,0,12" Padding="11,9" CornerRadius="10"
                    Background="#58343439">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="API 크레딧" Foreground="#D5D6DB" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="CreditText" Grid.Column="1" Text="확인 불가"
                               Foreground="#B9BAC1" FontSize="11.5" FontWeight="SemiBold" />
                </Grid>
            </Border>
            <StackPanel x:Name="RowsPanel" Grid.Row="3" />
            <TextBlock x:Name="UpdatedText" Grid.Row="4" Margin="0,12,0,0" Padding="0,10,0,0"
                       Foreground="#777982" FontSize="10.5" />
        </Grid>
    </Border>
</Window>
